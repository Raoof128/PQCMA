[flake8]
# Flake8 configuration for PQC Migration Auditor

# Maximum line length
max-line-length = 100

# Maximum complexity
max-complexity = 12

# Exclude patterns
exclude =
    .git,
    __pycache__,
    .mypy_cache,
    .pytest_cache,
    .tox,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .eggs,
    examples/dummy_repo

# Ignore specific errors
ignore =
    E203,  # Whitespace before ':' (conflicts with black)
    E501,  # Line too long (handled by max-line-length)
    W503,  # Line break before binary operator (conflicts with black)
    E402,  # Module level import not at top of file (sometimes needed)

# Select error codes to check
select =
    E,     # pycodestyle errors
    W,     # pycodestyle warnings
    F,     # pyflakes
    C,     # McCabe complexity
    B,     # flake8-bugbear
    I,     # isort

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    test_*.py:F401,F811,E501

# Show source code for errors
show-source = True

# Show error codes
show-pep8 = True

# Count errors
count = True

# Statistics
statistics = True

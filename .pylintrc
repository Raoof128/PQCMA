[MASTER]
# Use multiple processes to speed up Pylint
jobs=4

# Pickle collected data for later comparisons
persistent=yes

# List of plugins
load-plugins=

# Allow loading of arbitrary C extensions
unsafe-load-any-extension=no

[MESSAGES CONTROL]
# Disable specific warnings
disable=
    C0103,  # Invalid name (too restrictive)
    C0111,  # Missing docstring (handled by pydocstyle)
    C0114,  # Missing module docstring
    C0115,  # Missing class docstring
    C0116,  # Missing function docstring
    R0903,  # Too few public methods
    R0913,  # Too many arguments
    R0914,  # Too many local variables
    W0212,  # Access to protected member (sometimes needed)
    W0511,  # TODO comments
    W1203,  # Use lazy % formatting in logging
    E1101,  # No member (false positives with dynamic types)
    C0330,  # Wrong hanging indentation (conflicts with black)
    C0326,  # Bad whitespace (conflicts with black)

[REPORTS]
# Set the output format
output-format=colorized

# Include message's id in output
include-ids=yes

# Reports
reports=no

# Evaluate score
score=yes

[BASIC]
# Good variable names
good-names=i,j,k,ex,_,f,fp,fd,e,x,y,z,id,logger

# Regular expression for constants
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

# Regular expression for variable names
variable-rgx=[a-z_][a-z0-9_]{0,30}$

# Regular expression for function names
function-rgx=[a-z_][a-z0-9_]{2,40}$

# Regular expression for method names
method-rgx=[a-z_][a-z0-9_]{2,40}$

# Regular expression for class names
class-rgx=[A-Z_][a-zA-Z0-9]+$

# Regular expression for module names
module-rgx=(([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$

[FORMAT]
# Maximum line length
max-line-length=100

# Maximum lines in a module
max-module-lines=1000

# String quote consistency
string-quote=double-or-single

# Indent string
indent-string='    '

# Expected indent for hanging continuation
indent-after-paren=4

[DESIGN]
# Maximum number of arguments
max-args=7

# Maximum number of locals
max-locals=20

# Maximum return/yield statements
max-returns=6

# Maximum branches
max-branches=15

# Maximum statements
max-statements=60

# Minimum public methods for a class
min-public-methods=0

# Maximum public methods for a class
max-public-methods=25

# Maximum parents for a class
max-parents=7

# Maximum attributes for a class
max-attributes=12

[IMPORTS]
# Deprecated modules
deprecated-modules=

# Create graph of external dependencies
ext-import-graph=

# Create graph of internal dependencies
int-import-graph=

[CLASSES]
# List of method names to ignore
defining-attr-methods=__init__,__new__,setUp

# List of valid names for class attributes
valid-classmethod-first-arg=cls

# List of valid names for metaclass attributes
valid-metaclass-classmethod-first-arg=mcs

[EXCEPTIONS]
# Exceptions that trigger warnings
overgeneral-exceptions=Exception
